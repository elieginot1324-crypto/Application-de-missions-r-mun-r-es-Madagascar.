<title>MADAGASCAR EARN</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f3f7f5;color:#18352b}
header{background:linear-gradient(135deg,#075b42,#087c54,#075b9b);color:white;padding:22px 6%;border-radius:0 0 28px 28px}
nav{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}
.logo{font-size:23px;font-weight:900}
.logo span{color:#b9f5cf}
.actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
button{cursor:pointer;border:0;border-radius:10px;padding:12px 17px;font-weight:bold}
.login{background:white;color:#087c54}
.register{background:#b9f5cf;color:#075b42}
.language{background:#ffffff;color:#075b42;padding:10px 13px}
.hero{max-width:850px;margin:45px auto 25px;text-align:center}
.hero h1{font-size:35px;margin:10px 0}
.hero p{line-height:1.7}
.hero .register{margin:12px}
main{max-width:950px;margin:auto;padding:20px}
h2{font-size:21px;margin-top:32px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:15px}
.card{background:white;padding:20px;border-radius:17px;box-shadow:0 4px 15px #0000000b}
.card .symbol{font-size:32px}
.card p{font-size:13px;color:#718078;line-height:1.6}
.card button{width:100%;background:#e6f5ed;color:#087c54}
.info{background:#e6f5ed;padding:18px;border-radius:15px;line-height:1.9}
footer{text-align:center;padding:30px;color:#718078;font-size:12px}
@media(max-width:480px){
 .hero h1{font-size:27px}
 .logo{font-size:19px}
}
